# Copy this file to .env and fill in your own values. Never commit .env to git.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Claude API key from https://console.anthropic.com (pay-as-you-go, separate from a Claude.ai subscription).
# Leave empty to use the free basic (non-AI) fallback.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Daily automatic search time (Auckland time, 24h)
DAILY_SEARCH_HOUR=8
DAILY_SEARCH_MINUTE=0
