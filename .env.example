# Copy this file to .env and fill in your own values. Never commit .env to git.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# Each user now adds their OWN Claude key on their Settings page.
# Optional: a key here is used only for admin accounts that have not saved one.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Port for the dashboard on your laptop (8000 is used by the ERP). Open http://localhost:<APP_PORT>
APP_PORT=8010
# Daily automatic search time (Auckland time, 24h)
DAILY_SEARCH_HOUR=8
DAILY_SEARCH_MINUTE=0

# ---- Knowledge base (RAG) service - see docs/KNOWLEDGE_BASE.md ----
# Shared secret between the website and the knowledge base service (any long random text).
# Make one: python -c "import secrets;print(secrets.token_urlsafe(32))"
RAG_SERVICE_KEY=change-me-rag-key
# No Docker: the service runs on this laptop. (Docker sets http://rag:9000 by itself.)
RAG_BASE_URL=http://127.0.0.1:9010
# First-start AI model for knowledge base answers (the admin can change it on the Knowledge base page)
RAG_LLM_BASE_URL=https://api.deepseek.com/v1
RAG_LLM_MODEL=deepseek-chat
RAG_LLM_API_KEY=
